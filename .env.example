# ---- LLM (required for the full two-call flow) ------------------------------
# Provider precedence (first one with a key wins):
#   1. LLM_GATEWAY_API_KEY  — company OpenAI-compatible gateway (AWS-backed Claude)
#   2. ANTHROPIC_API_KEY    — Claude direct via the official SDK
#   3. DEEPSEEK_API_KEY     — DeepSeek direct
# The gateway speaks the OpenAI /chat/completions protocol; the Anthropic SDK
# is NOT required for it.
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=replace_with_a_new_key
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Anthropic direct (optional alternative to the gateway)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# DeepSeek direct (optional alternative to the gateway)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Server binding --------------------------------------------------------
# 127.0.0.1 keeps the service local-only. Use 0.0.0.0 inside containers or when
# you intend to reach it from another machine.
HOST=127.0.0.1
PORT=8080

# ---- Access control --------------------------------------------------------
# "user:pass" turns on HTTP Basic auth for every route. Leave empty ONLY while
# HOST is 127.0.0.1. Set it before exposing the service to any network.
AGENT_AUTH=

# ---- docker-compose only ---------------------------------------------------
# Which host interface to publish the container port on, and on what port.
BIND_ADDR=127.0.0.1
HOST_PORT=8080
